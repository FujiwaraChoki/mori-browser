.DS_Store
*.log

# Local build helpers and dependency checkouts. These are machine-local and can
# be re-created; they are not the Mori app source of truth.
binshims/
depot_tools/
ungoogled-chromium/

# Keep the full Chromium checkout and build output local, but track Mori's
# browser UI overlay inside the checkout path.
ungoogled-chromium-macos/**
!ungoogled-chromium-macos/
!ungoogled-chromium-macos/build/
!ungoogled-chromium-macos/build/src/
!ungoogled-chromium-macos/build/src/chrome/
!ungoogled-chromium-macos/build/src/chrome/browser/
!ungoogled-chromium-macos/build/src/chrome/browser/ui/
!ungoogled-chromium-macos/build/src/chrome/browser/ui/mori/
!ungoogled-chromium-macos/build/src/chrome/browser/ui/mori/**
