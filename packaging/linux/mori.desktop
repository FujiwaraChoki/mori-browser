[Desktop Entry]
Type=Application
Name=Mori
GenericName=Web Browser
Comment=A calm browser with spaces, a launcher, and Chromium inside
Exec=mori %U
Icon=mori
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupWMClass=mori
StartupNotify=true
Actions=new-tab;

[Desktop Action new-tab]
Name=New Tab
Exec=mori mori://newtab
