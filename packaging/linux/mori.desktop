[Desktop Entry]
Type=Application
Name=Mori
GenericName=Web Browser
Comment=A calm browser with spaces, a launcher, and Chromium inside
Keywords=Internet;WWW;Browser;Web;
Exec=mori %U
Icon=mori
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;x-scheme-handler/about;x-scheme-handler/unknown;
StartupWMClass=mori
StartupNotify=true
Actions=new-window;new-private-window;

[Desktop Action new-window]
Name=New Window
Exec=mori --new-window

[Desktop Action new-private-window]
Name=New Private Window
Exec=mori --private-window
