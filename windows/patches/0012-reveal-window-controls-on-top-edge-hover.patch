+
+bool BrowserFrameViewWin::UsesMoriHoverControls() const {
+  return !base::CommandLine::ForCurrentProcess()->HasSwitch("hide-window-buttons") &&
+         GetBrowserView()->ShouldDrawVerticalTabStrip() &&
+         !GetBrowserView()->IsWindowControlsOverlayEnabled();
+}
+
+void BrowserFrameViewWin::UpdateMoriHoverControls() {
+  if (!UsesMoriHoverControls() || !browser_widget()->IsVisible() ||
+      !browser_widget()->IsActive() || browser_widget()->IsFullscreen()) {
+    if (mori_hover_controls_) {
+      mori_hover_controls_->Hide();
+    }
+    return;
+  }
+
+  const gfx::Rect window_bounds = browser_widget()->GetWindowBoundsInScreen();
+  const gfx::Point cursor = display::Screen::Get()->GetCursorScreenPoint();
+  gfx::Rect reveal_edge = window_bounds;
+  reveal_edge.set_height(WindowTopY() + 8);
+  const bool over_edge = reveal_edge.Contains(cursor);
+  gfx::Rect controls_screen = mori_hover_controls_bounds_;
+  views::View::ConvertRectToScreen(GetBrowserView(), &controls_screen);
+  controls_screen.Outset(3);
+  const bool over_controls = mori_hover_controls_ &&
+      mori_hover_controls_->IsVisible() && controls_screen.Contains(cursor);
+  if (over_edge || over_controls) {
+    mori_controls_last_hover_ = base::TimeTicks::Now();
+  } else if (base::TimeTicks::Now() - mori_controls_last_hover_ >
+             base::Milliseconds(180)) {
+    if (mori_hover_controls_) {
+      mori_hover_controls_->Hide();
+    }
+    return;
+  } else if (!mori_hover_controls_ || !mori_hover_controls_->IsVisible()) {
+    return;
+  }
+
+  if (!mori_hover_controls_) {
+    mori_hover_controls_ = std::make_unique<mori::Overlay>(
+        GetBrowserView(), std::make_unique<BrowserCaptionButtonContainer>(this),
+        "MoriHoverWindowControls");
+  }
+  auto* controls = static_cast<BrowserCaptionButtonContainer*>(
+      mori_hover_controls_->contents());
+  if (!controls) {
+    return;
+  }
+  controls->UpdateButtons();
+  controls->SetBackground(views::CreateRoundedRectBackground(GetTitlebarColor(), 6));
+  const int controls_width = controls->GetPreferredSize().width();
+  gfx::Rect bounds(width() - controls_width - 4, WindowTopY() + 2,
+                   controls_width, 32);
+  bounds = views::View::ConvertRectToTarget(this, GetBrowserView(), bounds);
+  if (!mori_hover_controls_->IsVisible() || bounds != mori_hover_controls_bounds_) {
+    mori_hover_controls_->Show(bounds);
+    mori_hover_controls_bounds_ = bounds;
+  }
 }
 
