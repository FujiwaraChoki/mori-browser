{
  "manifest_version": 3,
  "name": "Mori Smoke Test",
  "version": "1.0",
  "description": "Checks that extensions load in the Linux Chromium build.",
  "action": {
    "default_title": "Mori Smoke Test",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      }
    }
  }
}
