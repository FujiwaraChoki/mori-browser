+// A folder entry survives repeated accelerator closes and WebContents swaps.
+IN_PROC_BROWSER_TEST_F(BrowserCommandsTest, CloseFolderTabUnloadsAndKeepsFolder) {
+  mori::NewFolder(browser());
+  auto* model = browser()->tab_strip_model();
+  const auto entry = model->GetActiveTab()->GetHandle();
+  const auto folder = mori::GetTabFolder(entry.Get());
+  ASSERT_TRUE(folder);
+  const std::string saved = mori::GetTabFolderData(entry.Get()->GetContents());
+  const int count = model->count();
+  for (int attempt = 0; attempt < 3; ++attempt) {
+    model->ActivateTabAt(model->GetIndexOfTab(entry.Get()));
+    chrome::ExecuteCommand(browser(), IDC_CLOSE_TAB);
+    EXPECT_EQ(count, model->count());
+    ASSERT_TRUE(entry.Get());
+    ASSERT_TRUE(mori::GetTabFolder(entry.Get()));
+    EXPECT_EQ(folder->id, mori::GetTabFolder(entry.Get())->id);
+    EXPECT_EQ(saved, mori::GetTabFolderData(entry.Get()->GetContents()));
+    EXPECT_NE(entry.Get(), model->GetActiveTab());
+    EXPECT_TRUE(entry.Get()->GetContents()->WasDiscarded());
+  }
+}
+
+IN_PROC_BROWSER_TEST_F(BrowserCommandsTest, MixedCloseKeepsFolderEntry) {
+  mori::NewFolder(browser());
+  auto* model = browser()->tab_strip_model();
+  const auto entry = model->GetActiveTab()->GetHandle();
+  const auto folder = mori::GetTabFolder(entry.Get());
+  ASSERT_TRUE(folder);
+  chrome::NewTab(browser(), NewTabTypes::kNewTabCommand);
+  const auto ordinary = model->GetActiveTab()->GetHandle();
+  const int count = model->count();
+  model->ActivateTabAt(model->GetIndexOfTab(entry.Get()));
+  model->AddSelectionFromAnchorTo(model->GetIndexOfTab(ordinary.Get()));
+  chrome::ExecuteCommand(browser(), IDC_CLOSE_TAB);
+  EXPECT_EQ(count - 2, model->count());
+  EXPECT_FALSE(ordinary.Get());
+  ASSERT_TRUE(entry.Get());
+  ASSERT_TRUE(mori::GetTabFolder(entry.Get()));
+  EXPECT_EQ(folder->id, mori::GetTabFolder(entry.Get())->id);
+}
+
+IN_PROC_BROWSER_TEST_F(BrowserCommandsTest, TabMovedOutOfFolderClosesNormally) {
+  mori::NewFolder(browser());
+  auto* model = browser()->tab_strip_model();
+  const auto entry = model->GetActiveTab()->GetHandle();
+  mori::RemoveTabFromFolder(browser(), entry.Get());
+  ASSERT_FALSE(mori::GetTabFolder(entry.Get()));
+  model->ActivateTabAt(model->GetIndexOfTab(entry.Get()));
+  const int count = model->count();
+  chrome::ExecuteCommand(browser(), IDC_CLOSE_TAB);
+  EXPECT_EQ(count - 1, model->count());
+  EXPECT_FALSE(entry.Get());
+}
+
+IN_PROC_BROWSER_TEST_F(BrowserCommandsTest, ExplicitCloseRemovesFolderTab) {
+  mori::NewFolder(browser());
+  auto* model = browser()->tab_strip_model();
+  const auto entry = model->GetActiveTab()->GetHandle();
+  const int count = model->count();
+  // Tab-row close buttons use this explicit removal path, not Close Tab.
+  model->CloseWebContentsAt(model->GetIndexOfTab(entry.Get()),
+                           TabCloseTypes::CLOSE_USER_GESTURE);
+  EXPECT_EQ(count - 1, model->count());
+  EXPECT_FALSE(entry.Get());
+}
