 int BrowserView::NonClientHitTest(const gfx::Point& point) {
+  // Mori's page card starts below infobars. Test them before treating the
+  // strip above the card as a draggable caption, including in fullscreen.
+  if (infobar_container_ && infobar_container_->GetVisible()) {
+    gfx::Point infobar_point(point);
+    if (ConvertedHitTest(parent(), infobar_container_, &infobar_point)) {
+      return HTCLIENT;
+    }
+  }
