+void SessionService::DeferWindowClose(SessionID window_id) {
+  deferred_window_closes_[window_id];
+  if (!pending_window_close_ids_.empty()) {
+    MakeDeferredWindowClosesPending();
+    return;
+  }
+  // Long enough for a compositor to work through the windows at logout, or for
+  // someone to close them by hand before quitting. A window closed this close to
+  // the end of the session coming back is much cheaper than losing one.
+  constexpr base::TimeDelta kDeferredWindowCloseDelay = base::Seconds(15);
+  base::SequencedTaskRunner::GetCurrentDefault()->PostDelayedTask(
+      FROM_HERE,
+      base::BindOnce(&SessionService::CommitDeferredWindowClose,
+                     weak_factory_.GetWeakPtr(), window_id),
+      kDeferredWindowCloseDelay);
+}
+
+void SessionService::CommitDeferredWindowClose(SessionID window_id) {
+  auto it = deferred_window_closes_.find(window_id);
+  if (it == deferred_window_closes_.end()) {
+    return;
+  }
+  for (SessionID tab_id : it->second) {
+    ScheduleCommand(sessions::CreateTabClosedCommand(tab_id));
+  }
+  ScheduleCommand(sessions::CreateWindowClosedCommand(window_id));
+  deferred_window_closes_.erase(it);
+  if (deferred_window_closes_.empty() && reset_after_deferred_closes_ &&
+      is_saving_enabled()) {
+    ScheduleResetCommands();
+  }
+}
+
+void SessionService::MakeDeferredWindowClosesPending() {
+  for (const auto& [window_id, tab_ids] : deferred_window_closes_) {
+    pending_window_close_ids_.insert(window_id);
+    pending_tab_close_ids_.insert(tab_ids.begin(), tab_ids.end());
+  }
+  deferred_window_closes_.clear();
+}
