+// Mori: a page's title usually arrives after the commit that SessionTabHelper
+// records, and nothing else writes the entry on a page that stays still. Such a
+// tab restores with no title and shows its URL until it loads.
+class SessionTitleObserver
+    : public content::WebContentsObserver,
+      public content::WebContentsUserData<SessionTitleObserver> {
+ public:
+  ~SessionTitleObserver() override = default;
+
+  void TitleWasSet(content::NavigationEntry* entry) override {
+    content::NavigationController& controller = web_contents()->GetController();
+    const int index = controller.GetLastCommittedEntryIndex();
+    if (!entry || index < 0 || controller.GetEntryAtIndex(index) != entry) {
+      return;
+    }
+    SessionTabHelperDelegate* delegate = delegate_lookup_.Run(web_contents());
+    const SessionTabHelper* helper =
+        SessionTabHelper::FromWebContents(web_contents());
+    if (!delegate || !helper) {
+      return;
+    }
+    delegate->UpdateTabNavigation(
+        helper->window_id(), helper->session_id(),
+        ContentSerializedNavigationBuilder::FromNavigationEntry(index, entry));
+  }
+
+ private:
+  friend class content::WebContentsUserData<SessionTitleObserver>;
+  SessionTitleObserver(content::WebContents* contents,
+                       SessionTabHelper::DelegateLookup lookup)
+      : content::WebContentsObserver(contents),
+        content::WebContentsUserData<SessionTitleObserver>(*contents),
+        delegate_lookup_(std::move(lookup)) {}
+
+  SessionTabHelper::DelegateLookup delegate_lookup_;
+
+  WEB_CONTENTS_USER_DATA_KEY_DECL();
+};
+
+WEB_CONTENTS_USER_DATA_KEY_IMPL(SessionTitleObserver);
+
+}  // namespace
