+TEST_P(TabCollectionAnimatingLayoutManagerTest, FolderVisibilityTransition) {
+  if (animation_axis() !=
+      TabCollectionAnimatingLayoutManager::AnimationAxis::kVertical) {
+    return;
+  }
+  gfx::ScopedAnimationDurationScaleMode normal_duration_mode(
+      gfx::ScopedAnimationDurationScaleMode::NORMAL_DURATION);
+  auto folder_layout = std::make_unique<FolderTransitionLayout>();
+  auto* folder = folder_layout.get();
+  SetLayoutManager(std::make_unique<TabCollectionAnimatingLayoutManager>(
+      std::move(folder_layout), *layout_manager_delegate(), animation_axis()));
+  widget()->SetBounds(gfx::Rect(0, 0, 200, 200));
+  auto* child = host_view()->AddChildView(std::make_unique<views::View>());
+  widget()->LayoutRootViewIfNecessary();
+  task_environment()->FastForwardBy(base::Seconds(1));
+  widget()->LayoutRootViewIfNecessary();
+  EXPECT_FALSE(child->GetVisible());
+
+  folder->open = true;
+  host_view()->InvalidateLayout();
+  widget()->LayoutRootViewIfNecessary();
+  task_environment()->FastForwardBy(base::Milliseconds(40));
+  widget()->LayoutRootViewIfNecessary();
+  EXPECT_TRUE(child->GetVisible());
+  EXPECT_EQ(child->x(), 28);
+  EXPECT_GE(child->y(), 114);
+  EXPECT_LT(child->y(), 120);
+  EXPECT_EQ(child->width(), 160);
+  EXPECT_EQ(child->height(), 40);
+  ASSERT_TRUE(child->layer());
+  EXPECT_GT(child->layer()->opacity(), 0.0f);
+  EXPECT_LT(child->layer()->opacity(), 1.0f);
+
+  task_environment()->FastForwardBy(base::Seconds(1));
+  widget()->LayoutRootViewIfNecessary();
+  EXPECT_EQ(child->bounds(), gfx::Rect(28, 120, 160, 40));
+  EXPECT_FLOAT_EQ(child->layer()->opacity(), 1.0f);
+
+  folder->open = false;
+  host_view()->InvalidateLayout();
+  widget()->LayoutRootViewIfNecessary();
+  task_environment()->FastForwardBy(base::Milliseconds(40));
+  widget()->LayoutRootViewIfNecessary();
+  EXPECT_TRUE(child->GetVisible());
+  EXPECT_EQ(child->x(), 28);
+  EXPECT_EQ(child->y(), 120);
+  EXPECT_GT(child->height(), 0);
+  EXPECT_LT(child->height(), 40);
+
+  // Reopening during collapse continues from the current bounds.
+  const gfx::Rect interrupted_bounds = child->bounds();
+  folder->open = true;
+  host_view()->InvalidateLayout();
+  widget()->LayoutRootViewIfNecessary();
+  EXPECT_EQ(child->bounds(), interrupted_bounds);
+  task_environment()->FastForwardBy(base::Seconds(1));
+  widget()->LayoutRootViewIfNecessary();
+  EXPECT_TRUE(child->GetVisible());
+  EXPECT_EQ(child->bounds(), gfx::Rect(28, 120, 160, 40));
+  EXPECT_FLOAT_EQ(child->layer()->opacity(), 1.0f);
+
+  folder->open = false;
+  host_view()->InvalidateLayout();
+  widget()->LayoutRootViewIfNecessary();
+  task_environment()->FastForwardBy(base::Seconds(1));
+  widget()->LayoutRootViewIfNecessary();
+  EXPECT_FALSE(child->GetVisible());
+}
 
