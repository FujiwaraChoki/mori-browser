+// Models a nested folder's child at a nonzero sidebar offset.
+class FolderTransitionLayout : public views::LayoutManagerBase {
+ public:
+  bool open = false;
+
+  views::ProposedLayout CalculateProposedLayout(
+      const views::SizeBounds& size_bounds) const override {
+    views::ProposedLayout layout;
+    layout.host_size = gfx::Size(200, open ? 160 : 120);
+    for (const auto& child : host_view()->children()) {
+      layout.child_layouts.emplace_back(
+          child, open, gfx::Rect(28, 120, 160, open ? 40 : 0));
+    }
+    return layout;
+  }
 };
 
