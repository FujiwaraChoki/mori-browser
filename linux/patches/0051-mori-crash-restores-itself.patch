+void SessionService::OnHeldSessionsRestored(Profile* restored_profile,
+                                            int num_tabs) {
+  if (restored_profile != profile()) {
+    return;
+  }
+  held_restore_subscription_ = {};
+  // Not before this session's file has them: a crash until then loses nothing.
+  SaveNow(base::BindPostTaskToCurrentDefault(
+      base::BindOnce(&SessionService::ReleaseHeldSessions,
+                     weak_factory_.GetWeakPtr())));
+}
+
+void SessionService::DismissHeldSessions() {
+  command_storage_manager()->ReadHeldSessionsNext();
