+  if (!base::PathExists(backup) && base::CopyFile(path, backup)) {
+    TrimSessionBackups();
+  }
+}
+
+bool CommandStorageBackend::HasHeldSessions() {
+  InitIfNecessary();
+  return !GetSessionFilesWithPrefix(kHeldPrefix).empty();
+}
+
+void CommandStorageBackend::ReadHeldSessionsNext() {
+  read_held_next_ = true;
+}
+
+void CommandStorageBackend::ReleaseHeldSessions() {
+  InitIfNecessary();
+  for (const base::FilePath& held : GetSessionFilesWithPrefix(kHeldPrefix)) {
+    base::FilePath::StringType name = held.BaseName().value();
+    name.erase(0, base::FilePath::StringType(kHeldPrefix).size());
+    base::Move(held, held.DirName().Append(
+                         base::FilePath::StringType(kBackupPrefix) + name));
+  }
+  TrimSessionBackups();
+}
+
+void CommandStorageBackend::DeleteSessionBackups() {
+  for (const base::FilePath& path : GetSessionFilesWithPrefix(kBackupPrefix)) {
+    base::DeleteFile(path);
+  }
+  for (const base::FilePath& path : GetSessionFilesWithPrefix(kHeldPrefix)) {
+    base::DeleteFile(path);
+  }
+}
+
+bool CommandStorageBackend::IsLastSessionBlank() const {
+  SessionFileReader::ReadResult read =
+      SessionFileReader::Read(last_session_info_->path, encryptor_.get());
+  if (IsCommandStorageReadError(read.status) && read.commands.empty()) {
+    return false;  // It can't be told. Keep it.
+  }
+  std::vector<std::unique_ptr<SessionWindow>> windows;
+  SessionID active_window_id = SessionID::InvalidValue();
+  std::string platform_session_id;
+  std::set<SessionID> discarded_window_ids;
+  RestoreSessionFromCommands(read.commands, &windows, &active_window_id,
+                             &platform_session_id, &discarded_window_ids);
+  for (const std::unique_ptr<SessionWindow>& window : windows) {
+    for (const std::unique_ptr<SessionTab>& tab : window->tabs) {
+      // The extra data is what a tab's folder and custom name are kept in.
+      if (!tab->extra_data.empty()) {
+        return false;
+      }
+      for (const SerializedNavigationEntry& entry : tab->navigations) {
+        if (!IsBlankPage(entry.virtual_url())) {
+          return false;
+        }
+      }
+    }
+  }
+  return true;
+}
+
+void CommandStorageBackend::TrimSessionBackups() const {
+  std::vector<base::FilePath> backups =
+      GetSessionFilesWithPrefix(kBackupPrefix);
+  for (size_t i = 0; i + kMaxSessionBackups < backups.size(); ++i) {
+    base::DeleteFile(backups[i]);
+  }
+}
+
+std::vector<base::FilePath> CommandStorageBackend::GetSessionFilesWithPrefix(
+    const base::FilePath::CharType* prefix) const {
+  std::vector<base::FilePath> files;
+  base::FileEnumerator file_enum(
+      supplied_path_.Append(is_encrypted() ? kEncryptedSessionsDirectory
+                                           : kSessionsDirectory),
+      false, base::FileEnumerator::FILES,
+      base::FilePath::StringType(prefix) +
+          GetSessionFilename(type_, FILE_PATH_LITERAL("*")));
+  for (base::FilePath name = file_enum.Next(); !name.empty();
+       name = file_enum.Next()) {
+    files.push_back(name);
+  }
+  // Their names end in the session's timestamp.
+  std::sort(files.begin(), files.end());
+  return files;
+}
