+#if BUILDFLAG(IS_LINUX)
+// Mori: Zen Browser is Firefox underneath; its profiles import the same way.
+void DetectZenProfiles(
+    const std::string& locale,
+    std::vector<user_data_importer::SourceProfile>* profiles) {
+  base::FilePath home;
+  if (!base::PathService::Get(base::DIR_HOME, &home)) {
+    return;
+  }
+  for (const char* root :
+       {".config/zen", ".zen", ".var/app/app.zen_browser.zen/.zen"}) {
+    const base::FilePath dir = home.AppendASCII(root);
+    std::string content;
+    if (!base::ReadFileToString(dir.AppendASCII("profiles.ini"), &content)) {
+      continue;
+    }
+    DictionaryValueINIParser parser;
+    parser.Parse(content);
+    for (int i = 0;; ++i) {
+      const std::string key = base::StringPrintf("Profile%d", i);
+      if (!parser.root().Find(key)) {
+        break;
+      }
+      const std::string* path =
+          parser.root().FindStringByDottedPath(key + ".Path");
+      if (!path) {
+        continue;
+      }
+      const std::string* relative =
+          parser.root().FindStringByDottedPath(key + ".IsRelative");
+      const base::FilePath profile_path =
+          relative && *relative == "0" ? base::FilePath(*path)
+                                       : dir.Append(*path);
+      if (!base::PathExists(profile_path.AppendASCII("places.sqlite"))) {
+        continue;
+      }
+      const std::string* name =
+          parser.root().FindStringByDottedPath(key + ".Name");
+      user_data_importer::SourceProfile zen;
+      zen.importer_name = u"Zen";
+      zen.profile = name ? base::UTF8ToUTF16(*name) : std::u16string();
+      zen.importer_type = user_data_importer::TYPE_FIREFOX;
+      zen.source_path = profile_path;
+      int version = 0;
+      GetFirefoxVersionAndPathFromProfile(profile_path, &version,
+                                          &zen.app_path);
+      zen.services_supported = user_data_importer::HISTORY |
+                               user_data_importer::FAVORITES |
+                               user_data_importer::AUTOFILL_FORM_DATA |
+                               user_data_importer::PASSWORDS;
+      zen.locale = locale;
+      profiles->push_back(zen);
+    }
+    return;
+  }
+}
+#endif  // BUILDFLAG(IS_LINUX)
