+namespace {
+
+// Mori: Zen's tab animations (ZenUIManager's animateItemOpen/Close). A tab
+// fades and grows from 0.95 as it opens and shrinks back as it closes, over
+// 120ms (100ms closing), easing out.
+constexpr base::TimeDelta kMoriSidebarAnimation = base::Milliseconds(120);
+constexpr double kMoriSidebarCloseShare = 100.0 / 120.0;
+
+// Scales `view`'s layer about the centre of `bounds` (its bounds this frame).
+void SetMoriScale(views::View* view, const gfx::Rect& bounds, double scale) {
+  if (!view->layer()) {
+    return;
+  }
+  gfx::Transform transform;
+  if (scale != 1.0) {
+    const float cx = bounds.width() / 2.0f;
+    const float cy = bounds.height() / 2.0f;
+    transform.Translate(cx, cy);
+    transform.Scale(scale, scale);
+    transform.Translate(-cx, -cy);
+  }
+  view->layer()->SetTransform(transform);
+}
+
+}  // namespace
+
